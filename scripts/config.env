# ============================================================================
# DreamZero custom-finetune config  (Wan2.2-TI2V-5B / LoRA / low-VRAM)
# Edit the values below, then: `source scripts/config.env` before running steps.
# ============================================================================

# --- Repo & paths -----------------------------------------------------------
# Root of the cloned dreamzero repo (the dir that contains groot/).
export DREAMZERO_ROOT="${DREAMZERO_ROOT:-$HOME/dreamzero}"

# --- Your embodiment --------------------------------------------------------
# A short lowercase tag identifying your robot. Used everywhere (configs, meta).
export EMB="myrobot"

# Number of camera views your robot has (you said: 2).
export NUM_VIEWS=2

# --- Your dataset (already LeRobot v2.0) ------------------------------------
# Path to your LeRobot v2 dataset root (contains data/ videos/ meta/info.json).
export DATA_ROOT="${DATA_ROOT:-/path/to/your_lerobot_dataset}"

# How your flat `observation.state` / `action` vectors are sliced into sub-keys.
# EDIT these to match your robot's state/action layout (start,end indices).
# Example below = 6 joint values + 1 gripper value = 7-dim state and action.
export STATE_KEYS='{"joint_pos": [0, 6], "gripper_pos": [6, 7]}'
export ACTION_KEYS='{"joint_pos": [0, 6], "gripper_pos": [6, 7]}'
# Sub-keys (names only) that should use relative-action statistics:
export RELATIVE_ACTION_KEYS="joint_pos gripper_pos"
# Column in your parquet holding the language instruction:
export TASK_KEY="annotation.task"
# Dataset frame rate (must match meta/info.json fps):
export FPS=30

# --- Training ---------------------------------------------------------------
export NUM_GPUS="${NUM_GPUS:-1}"            # you have 1-2 GPUs
export OUTPUT_DIR="${OUTPUT_DIR:-$DREAMZERO_ROOT/checkpoints/dreamzero_${EMB}_wan22_lora}"
export MAX_STEPS="${MAX_STEPS:-20000}"      # scale with dataset size
export LR="${LR:-1e-5}"
export BATCH_SIZE="${BATCH_SIZE:-1}"        # keep at 1 for low VRAM
export SAVE_STEPS="${SAVE_STEPS:-1000}"

# Wan2.2 video resolution (5B backbone default = 160x320). Match your cameras.
export IMG_W=320
export IMG_H=160

# --- Checkpoints (auto-downloaded by 00_setup.sh) ---------------------------
export WAN22_CKPT_DIR="$DREAMZERO_ROOT/checkpoints/Wan2.2-TI2V-5B"
export IMAGE_ENCODER_DIR="$DREAMZERO_ROOT/checkpoints/Wan2.1-I2V-14B-480P"  # CLIP only
export TOKENIZER_DIR="$DREAMZERO_ROOT/checkpoints/umt5-xxl"
export BASE_CKPT="$DREAMZERO_ROOT/checkpoints/DreamZero-AgiBot"             # LoRA base
